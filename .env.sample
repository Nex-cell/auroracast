# AuroraCast environment template.
# Copy to .env and fill in real values. Never commit .env.
# Only the uncommented lines are used right now; commented-out lines are for later stages.
# Non-secret settings (feed URLs, poll intervals, model params) belong in config/*.yaml, not here.

# --- General ---
TZ=UTC

# --- PostgreSQL + TimescaleDB (feature store, labels, prediction log) ---
# Service name in docker-compose; use "localhost" when running scripts on the host
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=auroracast
POSTGRES_USER=auroracast
POSTGRES_PASSWORD=change-me
# Port the database is published on, on this machine (localhost only); default 5432
POSTGRES_HOST_PORT=5432
# Absolute path for the database files; leave empty to use the Docker volume auroracast_timescale_data
TIMESCALE_DATA_PATH=
# Connection URL of an external database such as Tiger Cloud; leave empty if you have none
DATABASE_URL=

#Below here is not relevant yet

## --- MLflow (tracking + model registry) ---
#MLFLOW_TRACKING_URI=http://mlflow:5000
#MLFLOW_DB_NAME=mlflow              # separate database in the same Postgres instance
#MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
#
## --- Airflow ---
#AIRFLOW_UID=1000                   # run `id -u` on the host
#AIRFLOW_DB_NAME=airflow
#AIRFLOW_ADMIN_USER=admin
#AIRFLOW_ADMIN_PASSWORD=change-me
#AIRFLOW_FERNET_KEY=                # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#AIRFLOW_SECRET_KEY=                # python -c "import secrets; print(secrets.token_hex(32))"
#
## --- Streamlit ---
#STREAMLIT_PORT=8501